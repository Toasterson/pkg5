include ../Makefile.com

PYEXTSUFFIX.cmd = python$(USEPY)-config --extension-suffix

PYCFLAGS.cmd = python$(USEPY)-config --cflags
PYLDFLAGS.cmd = python$(USEPY)-config --ldflags
PYCFLAGS = $(PYCFLAGS.cmd:sh)
PYLDFLAGS = $(PYLDFLAGS.cmd:sh)

ROOTPYPKG= $(ROOT)/usr/lib/python$(USEPY)/vendor-packages/pkg

EXTENSIONS= actions/_actions actions/_common _varcet _misc solver elf
SOBJ= $(EXTENSIONS:%=%$(PYEXTSUFFIX))

actions/_actions$(PYEXTSUFFIX)	:= SOURCES = actions/_actions.c
actions/_common$(PYEXTSUFFIX)	:= SOURCES = actions/_common.c
_varcet$(PYEXTSUFFIX)		:= SOURCES = _varcet.c
_misc$(PYEXTSUFFIX)		:= SOURCES = _misc.c

elf$(PYEXTSUFFIX)		:= SOURCES = elf.c elfextract.c liblist.c
elf$(PYEXTSUFFIX)		:= CPPFLAGS = -I.
elf$(PYEXTSUFFIX)		:= LDFLAGS = -lelf -lmd

solver$(PYEXTSUFFIX)		:= SOURCES = solver/solver.c solver/py_solver.c
solver$(PYEXTSUFFIX)		:= CPPFLAGS = -D_FILE_OFFSET_BITS=64
solver$(PYEXTSUFFIX)		:= CERRWARN = \
					-Wno-strict-aliasing \
					-Wno-unused-function
solver$(PYEXTSUFFIX)		:= LDFLAGS = -ztext -lm -lc

all: $(SOBJ)

install: all $(ROOTPYPKG) $(SOBJ:%=$(ROOTPYPKG)/%)

clean:
clobber:
	$(RM) $(SOBJ)

$(ROOTPYPKG): FRC
	$(MKDIR) $@

$(ROOTPYPKG)/%.so: %.so
	$(MKDIR) $(@D)
	$(RM) $@; $(INSTALL) -f $(@D) -m 0555 $<

%.so: FRC
	$(CC) -shared -fPIC $(SOURCES) $(CPPFLAGS) $(CERRWARN) $(PYCFLAGS) \
	    $(PYLDFLAGS) $(LDFLAGS) -o $@

FRC:

